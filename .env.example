# API Keys for Investment News Analyzer
# 请将此文件复制为 .env 并填入真实的API密钥

# Gemini API - 用于AI新闻分析（必需）(https://ai.google.dev/)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase - 后端数据库存储（必需）(https://supabase.com/)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Finnhub API - 用于补充英文新闻（可选）(https://finnhub.io/)
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# Development settings
VITE_APP_TITLE=FinSight AI
VITE_APP_VERSION=1.0.0

