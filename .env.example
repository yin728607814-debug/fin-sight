# API Keys for Investment News Analyzer
# 请将此文件复制为 .env 并填入真实的API密钥

# News API - 获取金融新闻 (https://newsapi.org/)
NEWS_API_KEY=your_news_api_key_here
VITE_NEWS_API_KEY=your_news_api_key_here

# Alpha Vantage API - 获取股票价格数据 (https://www.alphavantage.co/)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
VITE_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Finnhub API - 获取纳斯达克新闻 (https://finnhub.io/)
FINNHUB_API_KEY=your_finnhub_api_key_here
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# Gemini API - 用于AI新闻分析 (https://ai.google.dev/)
# 注意：请使用 Gemini 2.5 Flash 模型
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Development settings
VITE_APP_TITLE=Investment News Analyzer
VITE_APP_VERSION=1.0.0

# Supabase - 后端数据库存储 (https://supabase.com/)
# 注意：请在 Supabase 控制台创建项目后获取这些值
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
