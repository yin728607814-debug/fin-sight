.analysis-page {
  padding-top: 18rpx;
  background: #070b14;
}

.asset-header {
  position: relative;
  padding: 30rpx 28rpx 28rpx;
  border: 1rpx solid #1d293b;
  border-radius: 16rpx;
  background:
    linear-gradient(112deg, rgba(101, 215, 255, 0.1), transparent 52%),
    #101724;
  overflow: hidden;
}

.gold-theme .asset-header {
  background:
    linear-gradient(112deg, rgba(235, 196, 116, 0.11), transparent 52%),
    #101724;
}

.asset-header::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 3rpx;
  background: #65d7ff;
  content: "";
}

.gold-theme .asset-header::before {
  background: #ebc474;
}

.asset-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.asset-code {
  color: #65d7ff;
  font-size: 20rpx;
  font-weight: 700;
}

.gold-theme .asset-code {
  color: #ebc474;
}

.market-state {
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 7rpx;
  color: #31dcac;
  background: rgba(49, 220, 172, 0.11);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.asset-title {
  display: block;
  margin-top: 22rpx;
  color: #f2f5fa;
  font-size: 46rpx;
  font-weight: 700;
}

.asset-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #7e8c9f;
  font-size: 25rpx;
}

.last-price {
  margin-top: 28rpx;
  color: #d9e1eb;
  font-size: 30rpx;
  font-weight: 700;
}

.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.mini-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 70rpx;
  border: 1rpx solid #223145;
  border-radius: 10rpx;
  background: transparent;
  color: #aeb9c8;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.mini-btn.primary {
  border-color: transparent;
  background: #65d7ff;
  color: #06131c;
}

.gold-theme .mini-btn.primary {
  background: #ebc474;
  color: #15120b;
}

.mini-btn-pressed {
  opacity: 0.76;
}

.mini-btn.is-loading {
  opacity: 0.72;
}

.button-spinner {
  width: 20rpx;
  height: 20rpx;
  border: 3rpx solid rgba(6, 19, 28, 0.24);
  border-top-color: currentColor;
  border-radius: 50%;
  animation: action-spin 0.8s linear infinite;
}

@keyframes action-spin {
  to {
    transform: rotate(360deg);
  }
}

.error-card,
.loading-card,
.summary-card,
.block {
  margin-top: 18rpx;
  padding: 26rpx;
}

.loading-title {
  display: block;
  margin: 16rpx 0 8rpx;
  color: #eff4fa;
  font-size: 30rpx;
  font-weight: 700;
}

.pulse {
  width: 34rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: #65d7ff;
}

.gold-theme .pulse {
  background: #ebc474;
}

.summary-head,
.block-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #65758b;
  font-size: 18rpx;
  font-weight: 700;
}

.section-title {
  display: block;
  color: #eff4fa;
  font-size: 31rpx;
  font-weight: 700;
}

.timestamp {
  display: block;
  margin-top: 8rpx;
  color: #728198;
  font-size: 22rpx;
}

.sentiment {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 30rpx;
  padding: 24rpx;
  border: 1rpx solid #182434;
  border-radius: 12rpx;
  background: #0b111c;
}

.sentiment-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 136rpx;
  height: 136rpx;
  border: 8rpx solid #65d7ff;
  border-radius: 50%;
}

.score {
  color: #f2f5fa;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1;
}

.score-label {
  margin-top: 6rpx;
  color: #738298;
  font-size: 18rpx;
}

.sentiment-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 18rpx;
  color: #7c8a9e;
  font-size: 23rpx;
}

.metric {
  display: flex;
  justify-content: space-between;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #172334;
}

.metric-value {
  color: #e9eff7;
  font-weight: 700;
}

.paragraph {
  display: block;
  margin-top: 24rpx;
  color: #aeb9c8;
  font-size: 27rpx;
  line-height: 1.7;
}

.paragraph.strong {
  color: #dce4ee;
  font-weight: 600;
}

.trend-chip {
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 7rpx;
  color: #91a0b3;
  background: #172333;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.trend-chip.positive {
  color: #31dcac;
  background: rgba(49, 220, 172, 0.12);
}

.trend-chip.negative {
  color: #fa6f84;
  background: rgba(250, 111, 132, 0.12);
}

.chart-shell {
  height: 216rpx;
  margin-top: 28rpx;
  border-radius: 10rpx;
  background: #0b111c;
  overflow: hidden;
}

.price-chart {
  width: 100%;
  height: 216rpx;
}

.chart-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 12rpx;
  margin-top: 12rpx;
}

.chart-label {
  color: #66758a;
  font-size: 20rpx;
}

.factor {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 10rpx;
  background: #0b111c;
}

.factor-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: 7rpx;
  background: rgba(101, 215, 255, 0.12);
  color: #65d7ff;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
}

.factor-text {
  flex: 1;
  color: #acb8c8;
  font-size: 26rpx;
  line-height: 1.55;
}

.gold-theme .factor-index {
  background: rgba(235, 196, 116, 0.13);
  color: #ebc474;
}

.count {
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 7rpx;
  color: #7c8b9f;
  background: #172333;
  font-size: 20rpx;
  line-height: 40rpx;
}

.news-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #172334;
}

.news-item:last-child {
  border-bottom: 0;
}

.news-title {
  display: block;
  color: #d7e0ea;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.55;
}

.news-meta {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 12rpx;
  color: #708096;
  font-size: 22rpx;
}
